{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    },
    "web-admin": {
      "root": "apps/web-admin",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_INTERNAL_URL"
        }
      ]
    },
    "web-customer": {
      "root": "apps/web-customer",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "API_INTERNAL_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "web-admin"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "web-admin"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web-customer"
      }
    }
  ]
}