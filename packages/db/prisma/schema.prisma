generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  STAFF
  SUPERADMIN

  @@map("admin_role")
}

enum Transmission {
  MANUAL
  AUTOMATIC

  @@map("transmission")
}

enum VehicleCategory {
  MPV
  SUV
  CITY_CAR
  SEDAN
  VAN

  @@map("vehicle_category")
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC

  @@map("fuel_type")
}

enum VehicleStatus {
  AVAILABLE
  RENTED
  HELD
  MAINTENANCE
  INACTIVE

  @@map("vehicle_status")
}

enum BookingStatus {
  PENDING_VERIFICATION
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED

  @@map("booking_status")
}

enum DocumentType {
  KTP
  SIM_A

  @@map("document_type")
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("document_status")
}

enum InvoiceStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOID

  @@map("invoice_status")
}

enum PricingRuleType {
  WEEKEND
  HOLIDAY
  HIGH_SEASON
  LONG_DURATION

  @@map("pricing_rule_type")
}

enum HandoverType {
  CHECKOUT
  CHECKIN

  @@map("handover_type")
}

enum ExpenseCategory {
  FUEL
  MAINTENANCE
  CLEANING
  SALARY
  OFFICE
  PARKING_TOLL
  OTHER

  @@map("expense_category")
}

model AdminUser {
  id                String              @id @default(uuid()) @db.Uuid
  name              String
  email             String              @unique
  passwordHash      String              @map("password_hash")
  role              AdminRole           @default(STAFF)
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?           @map("deleted_at") @db.Timestamptz(6)
  authSessions      AuthSession[]
  auditLogs         AuditLog[]          @relation("AuditLogActor")
  verifiedDocuments BookingDocument[]   @relation("DocumentVerifier")
  confirmedPayments Payment[]           @relation("PaymentConfirmer")
  handovers         Handover[]
  expenses          Expense[]

  @@index([isActive], map: "admin_users_is_active_idx")
  @@map("admin_users")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  adminUserId      String    @map("admin_user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  familyId         String    @default(uuid()) @map("family_id") @db.Uuid
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  adminUser        AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId], map: "auth_sessions_admin_user_id_idx")
  @@index([familyId], map: "auth_sessions_family_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

model AuditLog {
  id         String     @id @default(uuid()) @db.Uuid
  actorId    String?    @map("actor_id") @db.Uuid
  action     String
  objectType String     @map("object_type")
  objectId   String?    @map("object_id")
  before     Json?      @map("before")
  after      Json?      @map("after")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      AdminUser? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId], map: "audit_logs_actor_id_idx")
  @@index([objectType, objectId], map: "audit_logs_object_type_object_id_idx")
  @@index([createdAt], map: "audit_logs_created_at_idx")
  @@map("audit_logs")
}

model Vehicle {
  id           String          @id @default(uuid()) @db.Uuid
  brand        String
  model        String
  variant      String
  year         Int
  plate        String          @unique
  color        String
  transmission Transmission
  category     VehicleCategory
  fuelType     FuelType        @map("fuel_type")
  capacity     Int
  luggageCount Int             @map("luggage_count")
  mileage      Int
  facilities   String[]        @default([])
  description  String          @db.Text
  status       VehicleStatus   @default(AVAILABLE)
  featured     Boolean         @default(false)
  isDemo       Boolean         @default(false) @map("is_demo")
  deletedAt    DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  photos       VehiclePhoto[]
  rate         VehicleRate?
  bookingItems BookingItem[]
  pricingRules PricingRule[]
  maintenances Maintenance[]

  @@index([status], map: "vehicles_status_idx")
  @@index([category], map: "vehicles_category_idx")
  @@index([isDemo], map: "vehicles_is_demo_idx")
  @@map("vehicles")
}

model VehiclePhoto {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @map("vehicle_id") @db.Uuid
  objectKey String  @map("object_key")
  sortOrder Int     @map("sort_order")
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@unique([vehicleId, sortOrder])
  @@map("vehicle_photos")
}

model VehicleRate {
  id             String  @id @default(uuid()) @db.Uuid
  vehicleId      String  @unique @map("vehicle_id") @db.Uuid
  daily          Int
  weekly         Int?
  monthly        Int?
  driverPerDay   Int?    @map("driver_per_day")
  overtimeHourly Int?    @map("overtime_hourly")
  latePerDay     Int?    @map("late_per_day")
  vehicle        Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@map("vehicle_rates")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

// Customers never own an account or password; portal access is token based.
model Customer {
  id              String    @id @default(uuid()) @db.Uuid
  nik             String    @unique @db.VarChar(32)
  name            String
  whatsapp        String    @unique @db.VarChar(32)
  email           String?   @db.VarChar(254)
  address         String    @db.Text
  isBlacklisted   Boolean   @default(false) @map("is_blacklisted")
  blacklistReason String?   @map("blacklist_reason") @db.Text
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  bookings        Booking[]

  @@index([isBlacklisted], map: "customers_is_blacklisted_idx")
  @@map("customers")
}

model Booking {
  id            String               @id @default(uuid()) @db.Uuid
  bookingCode   String               @unique @map("booking_code") @db.VarChar(32)
  customerId    String               @map("customer_id") @db.Uuid
  status        BookingStatus        @default(PENDING_VERIFICATION)
  holdExpiresAt DateTime             @map("hold_expires_at") @db.Timestamptz(6)
  pickupOffice  String               @default("Kantor FA RENT CAR, Kedawung") @map("pickup_office")
  notes         String?              @db.Text
  internalNotes String?              @map("internal_notes") @db.Text
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?            @map("deleted_at") @db.Timestamptz(6)
  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items         BookingItem[]
  documents     BookingDocument[]
  accessTokens  BookingAccessToken[]
  invoices      Invoice[]
  driverRatings DriverRating[]

  @@index([customerId], map: "bookings_customer_id_idx")
  @@index([status], map: "bookings_status_idx")
  @@index([holdExpiresAt], map: "bookings_hold_expires_at_idx")
  @@index([createdAt], map: "bookings_created_at_idx")
  @@map("bookings")
}

model BookingItem {
  id              String   @id @default(uuid()) @db.Uuid
  bookingId       String   @map("booking_id") @db.Uuid
  vehicleId       String   @map("vehicle_id") @db.Uuid
  startDate       DateTime @map("start_date") @db.Timestamptz(6)
  endDate         DateTime @map("end_date") @db.Timestamptz(6)
  withDriver      Boolean  @default(false) @map("with_driver")
  driverPerDay    Int      @default(0) @map("driver_per_day")
  // Driver model arrives in Fase 3; keep the raw id until then.
  driverId        String?  @map("driver_id") @db.Uuid
  vehicleAmount   Int      @map("vehicle_amount")
  driverAmount    Int      @map("driver_amount")
  surchargeAmount Int      @map("surcharge_amount")
  promoDiscount   Int      @default(0) @map("promo_discount")
  totalAmount     Int      @map("total_amount")
  snapshot        Json
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  driver          Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  handovers       Handover[]
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([bookingId], map: "booking_items_booking_id_idx")
  @@index([vehicleId], map: "booking_items_vehicle_id_idx")
  @@index([startDate, endDate], map: "booking_items_period_idx")
  @@map("booking_items")
}

model BookingDocument {
  id              String         @id @default(uuid()) @db.Uuid
  bookingId       String         @map("booking_id") @db.Uuid
  type            DocumentType
  objectKey       String         @map("object_key") @db.VarChar(512)
  status          DocumentStatus @default(PENDING)
  rejectionReason String?        @map("rejection_reason") @db.Text
  verifiedBy      String?        @map("verified_by") @db.Uuid
  verifiedAt      DateTime?      @map("verified_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  verifier        AdminUser?     @relation("DocumentVerifier", fields: [verifiedBy], references: [id], onDelete: Restrict)

  @@index([bookingId], map: "booking_documents_booking_id_idx")
  @@index([status], map: "booking_documents_status_idx")
  @@map("booking_documents")
}

model BookingAccessToken {
  id         String    @id @default(uuid()) @db.Uuid
  bookingId  String    @map("booking_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  booking    Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId], map: "booking_access_tokens_booking_id_idx")
  @@index([expiresAt], map: "booking_access_tokens_expires_at_idx")
  @@map("booking_access_tokens")
}

// Invoices are immutable snapshots. Editing a booking creates a new version.
model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(32)
  bookingId     String        @map("booking_id") @db.Uuid
  version       Int           @default(1)
  status        InvoiceStatus @default(UNPAID)
  subtotal      Int
  discount      Int           @default(0)
  totalAmount   Int           @map("total_amount")
  bankAccount   Json          @map("bank_account")
  terms         String?       @db.Text
  issuedAt      DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz(6)
  pdfObjectKey  String?       @map("pdf_object_key") @db.VarChar(512)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  items         InvoiceItem[]
  payments      Payment[]

  @@unique([bookingId, version], map: "invoices_booking_id_version_key")
  @@index([bookingId], map: "invoices_booking_id_idx")
  @@index([status], map: "invoices_status_idx")
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  description String  @db.VarChar(255)
  quantity    Int     @default(1)
  unitPrice   Int     @map("unit_price")
  amount      Int
  metadata    Json?
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId], map: "invoice_items_invoice_id_idx")
  @@map("invoice_items")
}

// Manual bank transfer only. No payment gateway is modelled by design.
model Payment {
  id             String    @id @default(uuid()) @db.Uuid
  invoiceId      String    @map("invoice_id") @db.Uuid
  amount         Int
  paymentDate    DateTime  @map("payment_date") @db.Timestamptz(6)
  bankName       String    @map("bank_name") @db.VarChar(128)
  accountHolder  String?   @map("account_holder") @db.VarChar(128)
  proofObjectKey String    @map("proof_object_key") @db.VarChar(512)
  confirmedBy    String    @map("confirmed_by") @db.Uuid
  confirmedAt    DateTime  @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  confirmedAdmin AdminUser @relation("PaymentConfirmer", fields: [confirmedBy], references: [id], onDelete: Restrict)

  @@index([invoiceId], map: "payments_invoice_id_idx")
  @@index([paymentDate], map: "payments_payment_date_idx")
  @@map("payments")
}

model PricingRule {
  id                    String          @id @default(uuid()) @db.Uuid
  // null vehicle = rule applies to the whole fleet.
  vehicleId             String?         @map("vehicle_id") @db.Uuid
  name                  String          @db.VarChar(128)
  type                  PricingRuleType
  startDate             DateTime        @map("start_date") @db.Timestamptz(6)
  endDate               DateTime        @map("end_date") @db.Timestamptz(6)
  // e.g. 11000 = +10% (basis points, integer rupiah math only).
  multiplierBasisPoints Int?            @map("multiplier_basis_points")
  fixedSurcharge        Int?            @map("fixed_surcharge")
  isActive              Boolean         @default(true) @map("is_active")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  vehicle               Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([vehicleId], map: "pricing_rules_vehicle_id_idx")
  @@index([type], map: "pricing_rules_type_idx")
  @@index([startDate, endDate], map: "pricing_rules_period_idx")
  @@index([isActive], map: "pricing_rules_is_active_idx")
  @@map("pricing_rules")
}

model Driver {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  phone        String         @unique @db.VarChar(32)
  simNumber    String         @unique @map("sim_number") @db.VarChar(64)
  dailyRate    Int            @default(150000) @map("daily_rate")
  isActive     Boolean        @default(true) @map("is_active")
  notes        String?        @db.Text
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bookingItems BookingItem[]
  ratings      DriverRating[]

  @@index([isActive], map: "drivers_is_active_idx")
  @@map("drivers")
}

model DriverRating {
  id        String   @id @default(uuid()) @db.Uuid
  driverId  String   @map("driver_id") @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  score     Int
  feedback  String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Restrict)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([driverId, bookingId], map: "driver_ratings_driver_id_booking_id_key")
  @@index([driverId], map: "driver_ratings_driver_id_idx")
  @@index([bookingId], map: "driver_ratings_booking_id_idx")
  @@map("driver_ratings")
}

model Handover {
  id            String       @id @default(uuid()) @db.Uuid
  bookingItemId String       @map("booking_item_id") @db.Uuid
  type          HandoverType
  odometer      Int
  fuelLevel     Int          @map("fuel_level")
  notes         String?      @db.Text
  damageReport  Json?        @map("damage_report")
  photoKeys     String[]     @default([]) @map("photo_keys")
  extraFee      Int          @default(0) @map("extra_fee")
  signedByName  String       @map("signed_by_name")
  signedAt      DateTime     @default(now()) @map("signed_at") @db.Timestamptz(6)
  recordedBy    String       @map("recorded_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  bookingItem   BookingItem  @relation(fields: [bookingItemId], references: [id], onDelete: Restrict)
  recorder      AdminUser    @relation(fields: [recordedBy], references: [id], onDelete: Restrict)

  @@index([bookingItemId], map: "handovers_booking_item_id_idx")
  @@index([type], map: "handovers_type_idx")
  @@map("handovers")
}

model Expense {
  id             String          @id @default(uuid()) @db.Uuid
  category       ExpenseCategory
  amount         Int
  expenseDate    DateTime        @map("expense_date") @db.Timestamptz(6)
  description    String          @db.Text
  proofObjectKey String?         @map("proof_object_key") @db.VarChar(512)
  recordedBy     String          @map("recorded_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  recorder       AdminUser       @relation(fields: [recordedBy], references: [id], onDelete: Restrict)

  @@index([category], map: "expenses_category_idx")
  @@index([expenseDate], map: "expenses_expense_date_idx")
  @@map("expenses")
}

model Maintenance {
  id              String    @id @default(uuid()) @db.Uuid
  vehicleId       String    @map("vehicle_id") @db.Uuid
  serviceDate     DateTime  @map("service_date") @db.Timestamptz(6)
  odometer        Int
  cost            Int
  description     String    @db.Text
  nextServiceDate DateTime? @map("next_service_date") @db.Timestamptz(6)
  nextOdometer    Int?      @map("next_odometer")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  vehicle         Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([vehicleId], map: "maintenances_vehicle_id_idx")
  @@index([serviceDate], map: "maintenances_service_date_idx")
  @@map("maintenances")
}